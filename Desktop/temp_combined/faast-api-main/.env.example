# Sin DATABASE_URL, la API usa SQLite local (gamedex.db).
# Para Supabase: pega aquí el connection string PostgreSQL de tu proyecto.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@db.TU_PROYECTO.supabase.co:5432/postgres

# Para desarrollo puedes dejarlo en *.
# En producción, sustituye por el dominio de tu frontend separado por comas.
CORS_ORIGINS=*
